{
  "name": "moi-ngay-mot-chut",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start --hostname 0.0.0.0",
    "db:push": "prisma db push",
    "db:check": "prisma migrate status",
    "db:up": "node scripts/setup.cjs && docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:import-sqlite": "node --env-file=.env scripts/import-sqlite.cjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/test-e2e.cjs",
    "setup": "node scripts/setup.cjs && prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@prisma/client": "^6.19.0",
    "prisma": "^6.19.0",
    "next-auth": "^4.24.11",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  }
}
